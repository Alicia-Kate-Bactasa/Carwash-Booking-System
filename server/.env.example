# =========================================================================
# MONTAGE AUTO STUDIO - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and insert your local or production credentials.
# DO NOT COMMIT THE REAL .env FILE TO GIT!
# =========================================================================

# Server Configuration
PORT=5001
NODE_ENV=development

# Database Connection (Neon PostgreSQL / Supabase Postgres / Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/montage_db?schema=public"

# Authentication & Security Secrets
# Use a strong, random 64-character secret key in production
JWT_SECRET="your_secure_jwt_secret_key_here"

# PayMongo Payment Gateway Sandbox Secrets (GCash, Maya, Cards in PH)
# Register for free at https://dashboard.paymongo.com for test keys
PAYMONGO_SECRET_KEY="sk_test_your_paymongo_secret_key"
PAYMONGO_PUBLIC_KEY="pk_test_your_paymongo_public_key"
