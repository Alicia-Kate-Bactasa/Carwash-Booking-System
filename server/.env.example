# Port for Express Server
PORT=5000

# Direct PostgreSQL Database Connection String
# Replace with your actual PostgreSQL connection string (Supabase, Neon, Railway, or local Postgres)
# Example: postgresql://postgres.xxxx:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:password@localhost:5432/montageAutoStudio?schema=public"

# Supabase Auth Configuration (for token verification middleware)
SUPABASE_URL="https://YOUR_SUPABASE_PROJECT_ID.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
