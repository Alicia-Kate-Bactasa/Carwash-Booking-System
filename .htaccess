# Apache Configuration for Montage Auto Studio
# Serves frontend files from the client/ folder while maintaining clean root URLs

DirectoryIndex client/index.html index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Do not rewrite if request is already in client/ or server/
    RewriteCond %{REQUEST_URI} !^/client/
    
    # Rewrite root requests to client directory
    RewriteRule ^(.*)$ client/$1 [L]
</IfModule>
