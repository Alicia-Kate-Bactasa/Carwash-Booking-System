# Apache Configuration for Montage Auto Studio
# Serves compiled production frontend files from client/dist/ with Vue Router history fallback support

DirectoryIndex client/dist/index.html index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Proxy /api requests to local Express Node server on port 5001
    RewriteRule ^api/(.*)$ http://127.0.0.1:5001/api/$1 [P,L]

    # If the requested file or directory exists in client/dist, serve it directly
    RewriteCond %{DOCUMENT_ROOT}/client/dist%{REQUEST_URI} -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/client/dist%{REQUEST_URI} -d
    RewriteRule ^(.*)$ client/dist/$1 [L]

    # Fallback all non-file/non-directory requests (Vue Router history mode) to client/dist/index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ client/dist/index.html [L]
</IfModule>

